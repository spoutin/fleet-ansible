#!/usr/bin/env bash
# fleet-ansible CLI wrapper
set -e

APP_DIR="/opt/fleet-ansible"
ENV_FILE="/etc/fleet/openbao.env"

# Fallback to current directory if not installed in /opt
if [ ! -d "$APP_DIR" ] && [ -d "./inventory" ]; then
    APP_DIR="$(pwd)"
fi

export ANSIBLE_CONFIG="$APP_DIR/ansible.cfg"

# Load credentials from /etc/fleet/openbao.env if present
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
elif [ -f "$APP_DIR/openbao.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$APP_DIR/openbao.env"
    set +a
fi

# Locate Python and Ansible binaries
if [ -x "$APP_DIR/.venv/bin/ansible-playbook" ]; then
    ANSIBLE_PLAYBOOK="$APP_DIR/.venv/bin/ansible-playbook"
    ANSIBLE_CMD="$APP_DIR/.venv/bin/ansible"
    PYTHON_CMD="$APP_DIR/.venv/bin/python3"
else
    ANSIBLE_PLAYBOOK="ansible-playbook"
    ANSIBLE_CMD="ansible"
    PYTHON_CMD="python3"
fi

# Colors for interactive terminal output
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$(printf '\033[0m')
    C_BOLD=$(printf '\033[1m')
    C_DIM=$(printf '\033[2m')
    C_CYAN=$(printf '\033[0;36m')
    C_GREEN=$(printf '\033[0;32m')
    C_YELLOW=$(printf '\033[0;33m')
    C_BLUE=$(printf '\033[0;34m')
    C_RED=$(printf '\033[0;31m')
else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_RED=""
fi

get_controller_pubkey() {
    local key="<public-key>"
    for p in "${HOME}/.ssh/ansible_controller.pub" "/root/.ssh/ansible_controller.pub"; do
        if [ -f "$p" ]; then
            local rk
            rk="$(cat "$p" 2>/dev/null | tr -d '\r\n' || true)"
            if [ -n "$rk" ]; then
                key="$rk"
                break
            fi
        fi
    done
    printf '%s' "$key"
}

show_help() {
    local target_pubkey
    target_pubkey="$(get_controller_pubkey)"
    cat << EOF
${C_BOLD}${C_CYAN}fleet-ansible${C_RESET} - ${C_DIM}Spoutin Fleet Automation & SSH CA Trust Manager${C_RESET}

${C_BOLD}${C_YELLOW}Usage:${C_RESET}
  fleet-ansible [command] [target] [options]

${C_BOLD}${C_YELLOW}Commands:${C_RESET}
  ${C_BOLD}${C_GREEN}status${C_RESET} ${C_DIM}[target]${C_RESET}      Show fleet enrollment dashboard (live check, PAUSED, & error states)
  ${C_BOLD}${C_GREEN}bootstrap${C_RESET} ${C_DIM}[target]${C_RESET}   Run hybrid bootstrap for a target (IP, hostname, group, or whole fleet)
  ${C_BOLD}${C_GREEN}install-pki${C_RESET} ${C_DIM}[target]${C_RESET} Install and configure SSH CA trust on target (or whole fleet; pass --restart to force sshd restart)
  ${C_BOLD}${C_GREEN}restart-ssh${C_RESET} ${C_DIM}[target]${C_RESET}   Safely validate and restart sshd on target (or whole fleet)
  ${C_BOLD}${C_GREEN}ping${C_RESET} ${C_DIM}[target]${C_RESET}        Test SSH connectivity (IP, hostname, group, or whole fleet)
  ${C_BOLD}${C_GREEN}enroll${C_RESET}               Enroll controller key with OpenBao CA & configure SSH certificate
  ${C_BOLD}${C_GREEN}show-key${C_RESET}             Display controller public key (to paste into TrueNAS/cloud-init)
  ${C_BOLD}${C_GREEN}completion${C_RESET} ${C_DIM}[bash]${C_RESET}    Output shell tab-completion code (add to ~/.bashrc)
  ${C_BOLD}${C_GREEN}inventory${C_RESET}            Query dynamic inventory from LAN-Orangutan (outputs JSON)
  ${C_BOLD}${C_GREEN}raw${C_RESET}                  Execute arbitrary ansible-playbook arguments directly
  ${C_BOLD}${C_GREEN}help${C_RESET}                 Display this help message

${C_BOLD}${C_YELLOW}Targeting:${C_RESET}
  IP, Hostname, and Group can be used interchangeably directly or with --limit:
    ${C_CYAN}fleet-ansible ping 10.0.0.82${C_RESET}
    ${C_CYAN}fleet-ansible ping truenas${C_RESET}
    ${C_CYAN}fleet-ansible ping debian${C_RESET}
    ${C_CYAN}fleet-ansible ping hypervisors${C_RESET}

${C_BOLD}${C_YELLOW}Onboarding a New Device:${C_RESET}
  ${C_BOLD}1. Proxmox Guests (LXC / VM):${C_RESET}
     ${C_DIM}Zero-SSH push directly via the hypervisors (no guest credentials needed):${C_RESET}
       ${C_CYAN}fleet-ansible bootstrap hypervisors${C_RESET}

  ${C_BOLD}2. Standalone / Bare Metal Prerequisite:${C_RESET}
     ${C_DIM}Create 'ansible' user and configure passwordless sudo:${C_RESET}
       ${C_CYAN}echo "ansible ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ansible && chmod 0440 /etc/sudoers.d/ansible${C_RESET}
       ${C_DIM}(or check "Allow all sudo commands without password" in TrueNAS user settings)${C_RESET}

  ${C_BOLD}3. Authenticate & Install PKI Trust:${C_RESET}
     ${C_BOLD}a) With Password Auth:${C_RESET}
        ${C_CYAN}fleet-ansible install-pki <ip_or_hostname>${C_RESET}
        ${C_DIM}(pass -k if using a custom password not stored in OpenBao)${C_RESET}

     ${C_BOLD}b) With Key-Only Auth (e.g., TrueNAS / hardened Linux):${C_RESET}
        ${C_DIM}Run this on the target host to authorize the controller key:${C_RESET}
        ${C_CYAN}mkdir -p /home/ansible/.ssh && chmod 700 /home/ansible/.ssh && \\
touch /home/ansible/.ssh/authorized_keys && chmod 600 /home/ansible/.ssh/authorized_keys && \\
echo "${target_pubkey}" >> /home/ansible/.ssh/authorized_keys && \\
chown -R ansible:ansible /home/ansible/.ssh${C_RESET}
        ${C_DIM}(or in TrueNAS GUI: paste key into user 'ansible' -> SSH Public Key)${C_RESET}
        ${C_CYAN}fleet-ansible install-pki <ip_or_hostname>${C_RESET}
EOF
}

parse_target() {
    TARGET=""
    EXTRA_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit|-l)
                TARGET="$2"
                shift 2
                ;;
            -*)
                EXTRA_ARGS+=("$1")
                shift
                ;;
            *)
                if [ -z "$TARGET" ]; then
                    TARGET="$1"
                else
                    EXTRA_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
}

resolve_target() {
    if [ -z "$TARGET" ]; then
        return
    fi
    if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        return
    fi
    case "$TARGET" in
        all|managed_hosts|hypervisors|debian|ubuntu|alpine|redhat|proxmox|ungrouped)
            return
            ;;
    esac

    local find_output
    find_output="$("$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --find "$TARGET" 2>/dev/null || echo "[]")"
    local count
    count="$("$PYTHON_CMD" -c 'import json, sys; data=json.loads(sys.argv[1]); print(len(data))' "$find_output" 2>/dev/null || echo "0")"

    if [ "$count" -gt 1 ]; then
        if [ -t 0 ]; then
            echo ""
            echo "${C_BOLD}${C_YELLOW}Multiple hosts found matching '$TARGET':${C_RESET}"
            "$PYTHON_CMD" -c '
import json, sys
data = json.loads(sys.argv[1])
for i, d in enumerate(data, 1):
    ip = d.get("ip")
    name = d.get("name")
    vendor = d.get("vendor")
    lbl = d.get("label")
    lbl_str = f" - {lbl}" if lbl else ""
    print(f"  {i}) {ip} [{name}] ({vendor}{lbl_str})")
' "$find_output"
            local all_idx=$((count + 1))
            echo "  $all_idx) All (run on all $count matching hosts)"
            echo "  q) Cancel"
            echo ""

            while true; do
                read -r -p "Select target [1-$all_idx, q]: " choice
                case "$choice" in
                    [qQ])
                        echo "Operation cancelled."
                        exit 0
                        ;;
                    "$all_idx"|[aA]|all|ALL)
                        echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Selected: All matching hosts ($TARGET)${C_RESET}"
                        break
                        ;;
                    *)
                        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
                            local selected_ip
                            selected_ip="$("$PYTHON_CMD" -c "import json, sys; data=json.loads(sys.argv[1]); print(data[int(sys.argv[2])-1]['ip'])" "$find_output" "$choice")"
                            echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Selected:${C_RESET} ${C_CYAN}$selected_ip${C_RESET}"
                            TARGET="$selected_ip"
                            break
                        else
                            echo "Invalid selection. Please choose 1-$all_idx or q."
                        fi
                        ;;
                esac
            done
        else
            echo "${C_DIM}Notice: Multiple hosts found matching '$TARGET', targeting all matches non-interactively.${C_RESET}"
        fi
    fi
}

PASS_TMP_FILE=""

cleanup() {
    if [ -n "${PASS_TMP_FILE:-}" ] && [ -f "$PASS_TMP_FILE" ]; then
        rm -f "$PASS_TMP_FILE" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

setup_password_file() {
    # Don't set password file if user explicitly requested interactive password (-k)
    for arg in "$@"; do
        if [ "$arg" = "-k" ] || [ "$arg" = "--ask-pass" ]; then
            return
        fi
    done
    if [ -n "${ANSIBLE_CONNECTION_PASSWORD_FILE:-}" ]; then
        return
    fi

    local pass="${ANSIBLE_SSH_PASSWORD:-}"
    if [ -z "$pass" ]; then
        pass="$(PYTHONPATH="$APP_DIR" "$PYTHON_CMD" -c '
from inventory.orangutan import get_openbao_secrets
sec = get_openbao_secrets()
print(sec.get("ansible_ssh_password", ""))
' 2>/dev/null || true)"
    fi

    if [ -n "$pass" ] && [ "$pass" != "CHANGE_ME" ]; then
        local pass_dir="/tmp"
        [ -d "/dev/shm" ] && pass_dir="/dev/shm"
        PASS_TMP_FILE="$(mktemp "${pass_dir}/.fleet_pass.XXXXXX")"
        chmod 600 "$PASS_TMP_FILE"
        printf '%s' "$pass" > "$PASS_TMP_FILE"
        export ANSIBLE_CONNECTION_PASSWORD_FILE="$PASS_TMP_FILE"
    fi
}

run_ansible_playbook() {
    "$ANSIBLE_PLAYBOOK" "$@"
    local ret=$?
    cleanup
    exit $ret
}

run_ansible_cmd() {
    "$ANSIBLE_CMD" "$@"
    local ret=$?
    cleanup
    exit $ret
}

CMD="${1:-help}"
shift || true

case "$CMD" in
    status)
        setup_password_file "$@"
        "$PYTHON_CMD" "$APP_DIR/lib/status.py" "$@"
        RET=$?
        cleanup
        exit $RET
        ;;
    bootstrap)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Executing Hybrid Fleet Bootstrap for [${C_CYAN}$TARGET${C_RESET}${C_BOLD}]...${C_RESET}"
        else
            echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Executing Hybrid Fleet Bootstrap across entire fleet...${C_RESET}"
        fi
        run_ansible_playbook "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/bootstrap.yml" "${EXTRA_ARGS[@]}"
        ;;
    install-pki)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        CLEAN_EXTRA_ARGS=()
        FORCE_RESTART=false
        for arg in "${EXTRA_ARGS[@]}"; do
            if [ "$arg" = "--restart" ] || [ "$arg" = "-r" ]; then
                FORCE_RESTART=true
            else
                CLEAN_EXTRA_ARGS+=("$arg")
            fi
        done
        if [ "$FORCE_RESTART" = true ]; then
            CLEAN_EXTRA_ARGS+=(-e "restart_sshd=true")
        fi
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Installing SSH CA PKI Trust for [${C_CYAN}$TARGET${C_RESET}${C_BOLD}]...${C_RESET}"
        else
            echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Installing SSH CA PKI Trust Across Managed Fleet...${C_RESET}"
        fi
        run_ansible_playbook "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/install-pki.yml" "${CLEAN_EXTRA_ARGS[@]}"
        ;;
    restart-ssh)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        RESTART_TARGET="${TARGET:-all}"
        RESTART_INV=(-i "$APP_DIR/inventory")
        if [[ "$RESTART_TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            RESTART_INV+=(-i "$RESTART_TARGET,")
        fi
        echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Restarting SSH service on [${C_CYAN}$RESTART_TARGET${C_RESET}${C_BOLD}]...${C_RESET}"
        run_ansible_cmd "${RESTART_INV[@]}" "$RESTART_TARGET" -b -m shell -a "(/usr/sbin/sshd -t 2>/dev/null || sshd -t 2>/dev/null) && (systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || rc-service sshd restart 2>/dev/null || (which midclt >/dev/null 2>&1 && midclt call service.restart 'ssh') || true)" "${EXTRA_ARGS[@]}"
        ;;
    enroll|renew-cert)
        echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Enrolling Ansible Controller & Issuing SSH Certificate via OpenBao...${C_RESET}"
        run_ansible_playbook -i "$APP_DIR/inventory" "$APP_DIR/playbooks/enroll.yml" "$@"
        ;;
    completion)
        cat << 'COMPLETION_EOF'
# Bash completion for fleet-ansible
# Usage: source <(fleet-ansible completion)
_fleet_ansible_complete() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    local commands="status bootstrap install-pki restart-ssh ping enroll renew-cert show-key public-key completion inventory raw help"
    local options="-k --ask-pass -v -vvv -l --limit -r --restart -h --help"

    if [ "$cword" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    local cmd="${words[1]}"

    _get_targets() {
        local py="/opt/fleet-ansible/.venv/bin/python3"
        [ ! -x "$py" ] && py="python3"

        if [ -f "/opt/fleet-ansible/inventory/orangutan.py" ]; then
            "$py" /opt/fleet-ansible/inventory/orangutan.py --complete 2>/dev/null || echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        elif [ -f "./inventory/orangutan.py" ]; then
            "$py" ./inventory/orangutan.py --complete 2>/dev/null || echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        else
            echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        fi
    }

    case "$prev" in
        --limit|-l)
            local targets
            targets="$(_get_targets)"
            COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
            return 0
            ;;
    esac

    case "$cmd" in
        bootstrap|install-pki|ping)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$options" -- "$cur") )
            else
                local targets
                targets="$(_get_targets)"
                COMPREPLY=( $(compgen -W "$targets $options" -- "$cur") )
            fi
            return 0
            ;;
        raw)
            if declare -F _filedir >/dev/null 2>&1; then
                _filedir
            fi
            return 0
            ;;
        *)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$options" -- "$cur") )
            fi
            return 0
            ;;
    esac
}
complete -F _fleet_ansible_complete fleet-ansible
COMPLETION_EOF
        ;;
    inventory)
        if command -v jq >/dev/null 2>&1; then
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@" | jq .
        else
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@"
        fi
        ;;
    ping)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        PING_TARGET="${TARGET:-all}"
        PING_INV=(-i "$APP_DIR/inventory")
        if [[ "$PING_TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            PING_INV+=(-i "$PING_TARGET,")
        fi
        echo "${C_BOLD}${C_BLUE}==>${C_RESET} ${C_BOLD}Pinging hosts (${C_CYAN}$PING_TARGET${C_RESET}${C_BOLD})...${C_RESET}"
        if [[ " ${EXTRA_ARGS[*]} " == *" -v"* ]]; then
            run_ansible_cmd "${PING_INV[@]}" "$PING_TARGET" -m ping "${EXTRA_ARGS[@]}"
        else
            run_ansible_cmd "${PING_INV[@]}" "$PING_TARGET" -m ping -o "${EXTRA_ARGS[@]}" 2>/dev/null
        fi
        ;;
    show-key|public-key)
        PUB_KEY="$HOME/.ssh/ansible_controller.pub"
        if [ ! -f "$PUB_KEY" ] && [ -f "/root/.ssh/ansible_controller.pub" ]; then
            PUB_KEY="/root/.ssh/ansible_controller.pub"
        fi
        if [ -f "$PUB_KEY" ]; then
            KEY_CONTENT="$(cat "$PUB_KEY" 2>/dev/null | tr -d '\r\n')"
            echo "${C_BOLD}${C_GREEN}==>${C_RESET} ${C_BOLD}Ansible Controller Public Key (${C_CYAN}$PUB_KEY${C_RESET}${C_BOLD}):${C_RESET}"
            echo ""
            echo "$KEY_CONTENT"
            echo ""
            echo "${C_BOLD}${C_YELLOW}Non-Destructive Target Setup Command (paste into target host shell):${C_RESET}"
            echo "${C_CYAN}mkdir -p /home/ansible/.ssh && chmod 700 /home/ansible/.ssh && touch /home/ansible/.ssh/authorized_keys && chmod 600 /home/ansible/.ssh/authorized_keys && echo \"$KEY_CONTENT\" >> /home/ansible/.ssh/authorized_keys && chown -R ansible:ansible /home/ansible/.ssh${C_RESET}"
            echo ""
            echo "${C_DIM}(or in TrueNAS GUI: paste raw key into user 'ansible' -> SSH Public Key)${C_RESET}"
        else
            echo "${C_YELLOW}Notice: Controller key not found at $PUB_KEY${C_RESET}" >&2
            echo "Run 'fleet-ansible enroll' first to generate and enroll the key." >&2
            exit 1
        fi
        ;;
    raw)
        setup_password_file "$@"
        run_ansible_playbook -i "$APP_DIR/inventory" "$@"
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    *)
        echo "${C_BOLD}${C_RED}Error:${C_RESET} Unknown command '$CMD'" >&2
        echo "" >&2
        show_help >&2
        exit 1
        ;;
esac
