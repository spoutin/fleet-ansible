#!/usr/bin/env bash
# fleet-ansible CLI wrapper
set -e

APP_DIR="/opt/fleet-ansible"
ENV_FILE="/etc/fleet/openbao.env"

# Fallback to current directory if not installed in /opt
if [ ! -d "$APP_DIR" ] && [ -d "./inventory" ]; then
    APP_DIR="$(pwd)"
fi

export ANSIBLE_CONFIG="$APP_DIR/ansible.cfg"

# Load credentials from /etc/fleet/openbao.env if present
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
elif [ -f "$APP_DIR/openbao.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$APP_DIR/openbao.env"
    set +a
fi

# Locate Python and Ansible binaries
if [ -x "$APP_DIR/.venv/bin/ansible-playbook" ]; then
    ANSIBLE_PLAYBOOK="$APP_DIR/.venv/bin/ansible-playbook"
    ANSIBLE_CMD="$APP_DIR/.venv/bin/ansible"
    PYTHON_CMD="$APP_DIR/.venv/bin/python3"
else
    ANSIBLE_PLAYBOOK="ansible-playbook"
    ANSIBLE_CMD="ansible"
    PYTHON_CMD="python3"
fi

show_help() {
    cat << EOF
fleet-ansible - Spoutin Fleet Automation & SSH CA Trust Manager

Usage:
  fleet-ansible [command] [target] [options]

Commands:
  bootstrap [target]   Run hybrid bootstrap for a target (IP, hostname, group, or whole fleet)
  site [target]        Enforce SSH CA trust for a target (IP, hostname, group, or whole fleet)
  ping [target]        Test SSH connectivity (IP, hostname, group, or whole fleet)
  renew-cert           Generate controller key and request SSH certificate from OpenBao
  inventory            Query dynamic inventory from LAN-Orangutan (outputs JSON)
  raw                  Execute arbitrary ansible-playbook arguments directly
  help                 Display this help message

Targeting:
  IP, Hostname, and Group can be used interchangeably directly or with --limit:
    fleet-ansible bootstrap 10.0.0.82 -k
    fleet-ansible bootstrap truenas
    fleet-ansible site debian
    fleet-ansible ping 10.0.0.41
    fleet-ansible ping hypervisors
    fleet-ansible bootstrap --limit hypervisors
EOF
}

parse_target() {
    TARGET=""
    EXTRA_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit|-l)
                TARGET="$2"
                shift 2
                ;;
            -*)
                EXTRA_ARGS+=("$1")
                shift
                ;;
            *)
                if [ -z "$TARGET" ]; then
                    TARGET="$1"
                else
                    EXTRA_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
}

CMD="${1:-help}"
shift || true

case "$CMD" in
    bootstrap)
        parse_target "$@"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "==> Executing Hybrid Fleet Bootstrap for [$TARGET]..."
        else
            echo "==> Executing Hybrid Fleet Bootstrap across entire fleet..."
        fi
        exec "$ANSIBLE_PLAYBOOK" "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/bootstrap.yml" "${EXTRA_ARGS[@]}"
        ;;
    site)
        parse_target "$@"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "==> Enforcing SSH CA Trust for [$TARGET]..."
        else
            echo "==> Enforcing SSH CA Trust Across Managed Fleet..."
        fi
        exec "$ANSIBLE_PLAYBOOK" "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/site.yml" "${EXTRA_ARGS[@]}"
        ;;
    renew-cert)
        echo "==> Issuing Controller SSH Certificate via OpenBao..."
        exec "$ANSIBLE_PLAYBOOK" -i "$APP_DIR/inventory" "$APP_DIR/playbooks/renew-controller-cert.yml" "$@"
        ;;
    inventory)
        if command -v jq >/dev/null 2>&1; then
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@" | jq .
        else
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@"
        fi
        ;;
    ping)
        parse_target "$@"
        PING_TARGET="${TARGET:-all}"
        PING_INV=(-i "$APP_DIR/inventory")
        if [[ "$PING_TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            PING_INV+=(-i "$PING_TARGET,")
        fi
        echo "==> Pinging hosts ($PING_TARGET)..."
        if [[ " ${EXTRA_ARGS[*]} " == *" -v"* ]]; then
            exec "$ANSIBLE_CMD" "${PING_INV[@]}" "$PING_TARGET" -m ping "${EXTRA_ARGS[@]}"
        else
            exec "$ANSIBLE_CMD" "${PING_INV[@]}" "$PING_TARGET" -m ping -o "${EXTRA_ARGS[@]}" 2>/dev/null
        fi
        ;;
    raw)
        exec "$ANSIBLE_PLAYBOOK" -i "$APP_DIR/inventory" "$@"
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    *)
        echo "Error: Unknown command '$CMD'" >&2
        echo "" >&2
        show_help >&2
        exit 1
        ;;
esac
