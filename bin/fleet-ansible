#!/usr/bin/env bash
# fleet-ansible CLI wrapper
set -e

APP_DIR="/opt/fleet-ansible"
ENV_FILE="/etc/fleet/openbao.env"

# Fallback to current directory if not installed in /opt
if [ ! -d "$APP_DIR" ] && [ -d "./inventory" ]; then
    APP_DIR="$(pwd)"
fi

export ANSIBLE_CONFIG="$APP_DIR/ansible.cfg"

# Load credentials from /etc/fleet/openbao.env if present
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
elif [ -f "$APP_DIR/openbao.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$APP_DIR/openbao.env"
    set +a
fi

# Locate Python and Ansible binaries
if [ -x "$APP_DIR/.venv/bin/ansible-playbook" ]; then
    ANSIBLE_PLAYBOOK="$APP_DIR/.venv/bin/ansible-playbook"
    ANSIBLE_CMD="$APP_DIR/.venv/bin/ansible"
    PYTHON_CMD="$APP_DIR/.venv/bin/python3"
else
    ANSIBLE_PLAYBOOK="ansible-playbook"
    ANSIBLE_CMD="ansible"
    PYTHON_CMD="python3"
fi

show_help() {
    cat << EOF
fleet-ansible - Spoutin Fleet Automation & SSH CA Trust Manager

Usage:
  fleet-ansible [command] [target] [options]

Commands:
  bootstrap [target]   Run hybrid bootstrap for a target (IP, hostname, group, or whole fleet)
  install-pki [target] Install and configure SSH CA trust on target (or whole fleet)
  ping [target]        Test SSH connectivity (IP, hostname, group, or whole fleet)
  enroll               Enroll controller key with OpenBao CA & configure SSH certificate
  show-key             Display controller public key (to paste into TrueNAS/cloud-init)
  completion [bash]    Output shell tab-completion code (add to ~/.bashrc)
  inventory            Query dynamic inventory from LAN-Orangutan (outputs JSON)
  raw                  Execute arbitrary ansible-playbook arguments directly
  help                 Display this help message

Targeting:
  IP, Hostname, and Group can be used interchangeably directly or with --limit:
    fleet-ansible ping 10.0.0.82
    fleet-ansible ping truenas
    fleet-ansible ping debian
    fleet-ansible ping hypervisors

Onboarding a New Device:
  1. Proxmox Guests (LXC / VM):
     Zero-SSH push directly via the hypervisors (no guest credentials needed):
       fleet-ansible bootstrap hypervisors

  2. Standalone / Bare Metal with Password Auth:
     Ensure /etc/sudoers.d/ansible has "ansible ALL=(ALL) NOPASSWD:ALL", then run:
       fleet-ansible install-pki <ip_or_hostname>
       (pass -k if using a custom password not stored in OpenBao)

  3. Standalone with Key-Only Auth (e.g., TrueNAS):
     Run 'fleet-ansible show-key', paste public key into the user's authorized_keys, then:
       fleet-ansible install-pki <ip_or_hostname>
EOF
}

parse_target() {
    TARGET=""
    EXTRA_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit|-l)
                TARGET="$2"
                shift 2
                ;;
            -*)
                EXTRA_ARGS+=("$1")
                shift
                ;;
            *)
                if [ -z "$TARGET" ]; then
                    TARGET="$1"
                else
                    EXTRA_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
}

resolve_target() {
    if [ -z "$TARGET" ]; then
        return
    fi
    if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        return
    fi
    case "$TARGET" in
        all|managed_hosts|hypervisors|debian|ubuntu|alpine|redhat|proxmox|ungrouped)
            return
            ;;
    esac

    local find_output
    find_output="$("$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --find "$TARGET" 2>/dev/null || echo "[]")"
    local count
    count="$("$PYTHON_CMD" -c 'import json, sys; data=json.loads(sys.argv[1]); print(len(data))' "$find_output" 2>/dev/null || echo "0")"

    if [ "$count" -gt 1 ]; then
        if [ -t 0 ]; then
            echo ""
            echo "Multiple hosts found matching '$TARGET':"
            "$PYTHON_CMD" -c '
import json, sys
data = json.loads(sys.argv[1])
for i, d in enumerate(data, 1):
    ip = d.get("ip")
    name = d.get("name")
    vendor = d.get("vendor")
    lbl = d.get("label")
    lbl_str = f" - {lbl}" if lbl else ""
    print(f"  {i}) {ip} [{name}] ({vendor}{lbl_str})")
' "$find_output"
            local all_idx=$((count + 1))
            echo "  $all_idx) All (run on all $count matching hosts)"
            echo "  q) Cancel"
            echo ""

            while true; do
                read -r -p "Select target [1-$all_idx, q]: " choice
                case "$choice" in
                    [qQ])
                        echo "Operation cancelled."
                        exit 0
                        ;;
                    "$all_idx"|[aA]|all|ALL)
                        echo "==> Selected: All matching hosts ($TARGET)"
                        break
                        ;;
                    *)
                        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "$count" ]; then
                            local selected_ip
                            selected_ip="$("$PYTHON_CMD" -c "import json, sys; data=json.loads(sys.argv[1]); print(data[int(sys.argv[2])-1]['ip'])" "$find_output" "$choice")"
                            echo "==> Selected: $selected_ip"
                            TARGET="$selected_ip"
                            break
                        else
                            echo "Invalid selection. Please choose 1-$all_idx or q."
                        fi
                        ;;
                esac
            done
        else
            echo "Notice: Multiple hosts found matching '$TARGET', targeting all matches non-interactively."
        fi
    fi
}

PASS_TMP_FILE=""

cleanup() {
    if [ -n "${PASS_TMP_FILE:-}" ] && [ -f "$PASS_TMP_FILE" ]; then
        rm -f "$PASS_TMP_FILE" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

setup_password_file() {
    # Don't set password file if user explicitly requested interactive password (-k)
    for arg in "$@"; do
        if [ "$arg" = "-k" ] || [ "$arg" = "--ask-pass" ]; then
            return
        fi
    done
    if [ -n "${ANSIBLE_CONNECTION_PASSWORD_FILE:-}" ]; then
        return
    fi

    local pass="${ANSIBLE_SSH_PASSWORD:-}"
    if [ -z "$pass" ]; then
        pass="$(PYTHONPATH="$APP_DIR" "$PYTHON_CMD" -c '
from inventory.orangutan import get_openbao_secrets
sec = get_openbao_secrets()
print(sec.get("ansible_ssh_password", ""))
' 2>/dev/null || true)"
    fi

    if [ -n "$pass" ] && [ "$pass" != "CHANGE_ME" ]; then
        local pass_dir="/tmp"
        [ -d "/dev/shm" ] && pass_dir="/dev/shm"
        PASS_TMP_FILE="$(mktemp "${pass_dir}/.fleet_pass.XXXXXX")"
        chmod 600 "$PASS_TMP_FILE"
        printf '%s' "$pass" > "$PASS_TMP_FILE"
        export ANSIBLE_CONNECTION_PASSWORD_FILE="$PASS_TMP_FILE"
    fi
}

run_ansible_playbook() {
    "$ANSIBLE_PLAYBOOK" "$@"
    local ret=$?
    cleanup
    exit $ret
}

run_ansible_cmd() {
    "$ANSIBLE_CMD" "$@"
    local ret=$?
    cleanup
    exit $ret
}

CMD="${1:-help}"
shift || true

case "$CMD" in
    bootstrap)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "==> Executing Hybrid Fleet Bootstrap for [$TARGET]..."
        else
            echo "==> Executing Hybrid Fleet Bootstrap across entire fleet..."
        fi
        run_ansible_playbook "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/bootstrap.yml" "${EXTRA_ARGS[@]}"
        ;;
    install-pki)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        INV_ARGS=(-i "$APP_DIR/inventory")
        LIMIT_ARGS=()
        if [ -n "$TARGET" ]; then
            if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                INV_ARGS+=(-i "$TARGET,")
            fi
            LIMIT_ARGS=(--limit "$TARGET")
            echo "==> Installing SSH CA PKI Trust for [$TARGET]..."
        else
            echo "==> Installing SSH CA PKI Trust Across Managed Fleet..."
        fi
        run_ansible_playbook "${INV_ARGS[@]}" "${LIMIT_ARGS[@]}" "$APP_DIR/playbooks/install-pki.yml" "${EXTRA_ARGS[@]}"
        ;;
    enroll|renew-cert)
        echo "==> Enrolling Ansible Controller & Issuing SSH Certificate via OpenBao..."
        run_ansible_playbook -i "$APP_DIR/inventory" "$APP_DIR/playbooks/enroll.yml" "$@"
        ;;
    completion)
        cat << 'COMPLETION_EOF'
# Bash completion for fleet-ansible
# Usage: source <(fleet-ansible completion)
_fleet_ansible_complete() {
    local cur prev words cword
    if declare -F _init_completion >/dev/null 2>&1; then
        _init_completion || return
    else
        COMPREPLY=()
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
        words=("${COMP_WORDS[@]}")
        cword=$COMP_CWORD
    fi

    local commands="bootstrap install-pki ping enroll renew-cert show-key public-key completion inventory raw help"
    local options="-k --ask-pass -v -vvv -l --limit -h --help"

    if [ "$cword" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
        return 0
    fi

    local cmd="${words[1]}"

    _get_targets() {
        local py="/opt/fleet-ansible/.venv/bin/python3"
        [ ! -x "$py" ] && py="python3"

        if [ -f "/opt/fleet-ansible/inventory/orangutan.py" ]; then
            "$py" /opt/fleet-ansible/inventory/orangutan.py --complete 2>/dev/null || echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        elif [ -f "./inventory/orangutan.py" ]; then
            "$py" ./inventory/orangutan.py --complete 2>/dev/null || echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        else
            echo "hypervisors managed_hosts debian ubuntu alpine redhat proxmox pve1 pve2 all"
        fi
    }

    case "$prev" in
        --limit|-l)
            local targets
            targets="$(_get_targets)"
            COMPREPLY=( $(compgen -W "$targets" -- "$cur") )
            return 0
            ;;
    esac

    case "$cmd" in
        bootstrap|install-pki|ping)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$options" -- "$cur") )
            else
                local targets
                targets="$(_get_targets)"
                COMPREPLY=( $(compgen -W "$targets $options" -- "$cur") )
            fi
            return 0
            ;;
        raw)
            if declare -F _filedir >/dev/null 2>&1; then
                _filedir
            fi
            return 0
            ;;
        *)
            if [[ "$cur" == -* ]]; then
                COMPREPLY=( $(compgen -W "$options" -- "$cur") )
            fi
            return 0
            ;;
    esac
}
complete -F _fleet_ansible_complete fleet-ansible
COMPLETION_EOF
        ;;
    inventory)
        if command -v jq >/dev/null 2>&1; then
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@" | jq .
        else
            exec "$PYTHON_CMD" "$APP_DIR/inventory/orangutan.py" --list "$@"
        fi
        ;;
    ping)
        parse_target "$@"
        resolve_target
        setup_password_file "${EXTRA_ARGS[@]}"
        PING_TARGET="${TARGET:-all}"
        PING_INV=(-i "$APP_DIR/inventory")
        if [[ "$PING_TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            PING_INV+=(-i "$PING_TARGET,")
        fi
        echo "==> Pinging hosts ($PING_TARGET)..."
        if [[ " ${EXTRA_ARGS[*]} " == *" -v"* ]]; then
            run_ansible_cmd "${PING_INV[@]}" "$PING_TARGET" -m ping "${EXTRA_ARGS[@]}"
        else
            run_ansible_cmd "${PING_INV[@]}" "$PING_TARGET" -m ping -o "${EXTRA_ARGS[@]}" 2>/dev/null
        fi
        ;;
    show-key|public-key)
        PUB_KEY="$HOME/.ssh/ansible_controller.pub"
        if [ ! -f "$PUB_KEY" ] && [ -f "/root/.ssh/ansible_controller.pub" ]; then
            PUB_KEY="/root/.ssh/ansible_controller.pub"
        fi
        if [ -f "$PUB_KEY" ]; then
            echo "==> Ansible Controller Public Key ($PUB_KEY):"
            echo ""
            cat "$PUB_KEY"
            echo ""
            echo "Tip: Paste this key into /home/ansible/.ssh/authorized_keys (or TrueNAS / cloud-init)"
            echo "on servers where password authentication is disabled."
        else
            echo "Notice: Controller key not found at $PUB_KEY" >&2
            echo "Run 'fleet-ansible enroll' first to generate and enroll the key." >&2
            exit 1
        fi
        ;;
    raw)
        setup_password_file "$@"
        run_ansible_playbook -i "$APP_DIR/inventory" "$@"
        ;;
    help|--help|-h)
        show_help
        exit 0
        ;;
    *)
        echo "Error: Unknown command '$CMD'" >&2
        echo "" >&2
        show_help >&2
        exit 1
        ;;
esac
