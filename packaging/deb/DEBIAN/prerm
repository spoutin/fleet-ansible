#!/usr/bin/env bash
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v systemctl >/dev/null 2>&1; then
        systemctl stop fleet-ansible-renew-cert.timer 2>/dev/null || true
        systemctl disable fleet-ansible-renew-cert.timer 2>/dev/null || true
        systemctl stop fleet-ansible.timer 2>/dev/null || true
        systemctl disable fleet-ansible.timer 2>/dev/null || true
    fi
fi

exit 0
